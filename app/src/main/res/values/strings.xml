    <!-- 原理卡片 -->
    <string name="module_app_principle_title">原理</string>
    <string name="module_app_principle_desc">本模块 Hook MediaProvider 进程内 libc 的 mkdir / mkdirat，只要检测到目标是外置卷根目录下的第一层目录，就返回成功但不真正创建。\n\n• 不依赖硬编码目录名，零遗漏\n• 排除内部存储 /storage/emulated\n• 更深层子目录不受影响</string>


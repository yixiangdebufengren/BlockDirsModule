    <!-- 使用说明（已修正：无需勾选系统框架，无需重启） -->
    <string name="usage_tip">在 LSPosed 中启用本模块，作用域勾选「com.android.providers.media」和「com.android.providers.media.module」即可，无需勾选系统框架，启用后立即生效，无需重启。</string>


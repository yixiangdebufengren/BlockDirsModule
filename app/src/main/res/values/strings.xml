    <string name="app_subtitle">阻止外置存储自动创建标准媒体目录</string>

    <!-- 使用说明（已修正：无需勾选系统框架，无需重启） -->
    <string name="usage_tip">在 LSPosed 中启用本模块，作用域勾选\n「com.android.providers.media」和\n「com.android.providers.media.module」即可。</string>

